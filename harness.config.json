{
  "$schema": "./harness.schema.json",
  "project": "reuniones-vdo-ninja",
  "language": "generic",
  "description": "Imágenes de VDO.Ninja para reuniones.cenitdigital.es: shellcheck del parche y tests con node --test.",
  "commands": {
    "install": "",
    "lint": "shellcheck src/web/parche-config.sh",
    "test": "node --test tests/*.test.mjs",
    "mutate": "",
    "build": ""
  },
  "paths": {
    "src": "src",
    "tests": "tests"
  },
  "mutation": {
    "threshold": 0.8,
    "targets": []
  },
  "rules": {
    "require_tests_to_close": false,
    "require_mutation_to_close": false
  }
}
